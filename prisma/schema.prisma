generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// 1. User & Authentication
// ----------------------------------------------------
model User {
  id           String   @id @default(cuid())
  loginId      String   @unique // 6-12 chars as per spec
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("STAFF") // "MANAGER", "STAFF"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ----------------------------------------------------
// 2. Warehouses & Physical/Virtual Locations
// ----------------------------------------------------
model Warehouse {
  id        String     @id @default(cuid())
  name      String     // e.g. "Main Warehouse"
  shortCode String     @unique // e.g. "WH", "WH2"
  address   String
  locations Location[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Location {
  id          String            @id @default(cuid())
  name        String            // e.g. "Stock1", "Production Floor", "Vendors", "Customers"
  shortCode   String            @unique // e.g. "WH/Stock1", "WH/Stock2", "Partner/Vendors"
  type        String            @default("INTERNAL") // "INTERNAL", "VENDOR", "CUSTOMER", "INVENTORY_LOSS"
  warehouseId String?
  warehouse   Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockLevels StockLevel[]
  movesFrom   StockMoveLedger[] @relation("FromLocation")
  movesTo     StockMoveLedger[] @relation("ToLocation")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

// ----------------------------------------------------
// 3. Products & Stock Level Snapshot
// ----------------------------------------------------
model Product {
  id             String              @id @default(cuid())
  name           String              // e.g. "Desk", "Table", "Steel Rods"
  sku            String              @unique // e.g. "DESK001", "TAB001", "STL001"
  category       String              @default("Furniture") // "Furniture", "Raw Materials", "Components", "Office"
  uom            String              @default("Units") // "Units", "kg", "meters"
  perUnitCost    Float               @default(0.0) // Wireframe: "Desk — ₹3000"
  minStock       Float               @default(10.0) // Reordering rule
  stockLevels    StockLevel[]
  operationLines StockOperationLine[]
  moveLedgers    StockMoveLedger[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model StockLevel {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHand     Float    @default(0.0)
  reserved   Float    @default(0.0) // Free to Use = onHand - reserved
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
}

// ----------------------------------------------------
// 4. Stock Operations (Receipts, Deliveries, Adjustments, Transfers)
// ----------------------------------------------------
model StockOperation {
  id               String               @id @default(cuid())
  reference        String               @unique // Format: WH/IN/0001, WH/OUT/0001
  type             String               // "RECEIPT", "DELIVERY", "INTERNAL", "ADJUSTMENT"
  status           String               @default("DRAFT") // "DRAFT", "WAITING", "READY", "DONE", "CANCELED"
  contact          String?              // e.g. "Azure Interior", "Deco Addict"
  scheduleDate     DateTime             @default(now())
  responsibleName  String?              // Auto-filled with logged-in user
  sourceLocationId String?
  destLocationId   String?
  notes            String?
  lines            StockOperationLine[]
  moves            StockMoveLedger[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model StockOperationLine {
  id           String         @id @default(cuid())
  operationId  String
  operation    StockOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  qtyDemanded  Float
  qtyDone      Float          @default(0.0)
  isOutOfStock Boolean        @default(false) // Flags out-of-stock items in red on Delivery
}

// ----------------------------------------------------
// 5. Stock Move Ledger (Immutable Audit Trail)
// ----------------------------------------------------
model StockMoveLedger {
  id             String          @id @default(cuid())
  reference      String          // e.g. WH/IN/0001, WH/OUT/0002
  operationId    String?
  operation      StockOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  fromLocationId String
  fromLocation   Location        @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location        @relation("ToLocation", fields: [toLocationId], references: [id])
  contact        String?
  quantity       Float
  moveType       String          // "IN", "OUT", "INTERNAL", "ADJUSTMENT"
  status         String          @default("READY") // "READY", "DONE", "CANCELED"
  date           DateTime        @default(now())
  notes          String?
}
